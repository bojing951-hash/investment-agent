# investment-agent 环境变量模板(复制为 .env 并填入你自己的Key)
#   cp .env.example .env
# .env 已被 .gitignore 忽略,不会被提交;进程环境变量优先于 .env。
# 所有Key均为可选——不配置对应功能时:数据采集主流程仍可运行(见 docs/USER_GUIDE.md"配置"一章)。

# ── 可选通用模型 API(任意 OpenAI 兼容端点;三项一起配置) ──
# 可选;Agent Native(默认)不需要模型 Key,系统自动走确定性分支。
# 金融数据源 Key(下方 FRED/tushare/Finnhub)与模型 Key 相互独立。
# 如沿用智谱: MODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4 / MODEL_NAME=glm-5.3
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=

# ── FRED 宏观数据(推荐:美国宏观指标采集) ──
# 申请: https://fred.stlouisfed.org/docs/api/api_key.html (免费,注册即得)
FRED_API_KEY=

# ── tushare Pro(可选:A股/港股数据,积分不足时采集器自动降级) ──
# 申请: https://tushare.pro/ (免费注册,部分接口需积分)
TUSHARE_TOKEN=

# ── Finnhub(可选:新闻采集;不配置时新闻步骤降级,不影响其他数据) ──
# 申请: https://finnhub.io/ (免费档即可)
FINNHUB_API_KEY=

# ── 网络代理(可选:默认探测本机 http://127.0.0.1:7890,不可用自动直连) ──
# YF_PROXY=http://127.0.0.1:7890
