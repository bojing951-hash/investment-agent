DIGR = "零一二三四五六七八九"


def cn(x, nd=None):
    """4.0->四点零 (nd=1), 1.9->一点九, 50->五十, 25->二十五"""
    if nd is None:
        s = "%g" % round(float(x), 6)
    else:
        s = "%.*f" % (nd, float(x))
    a, _, b = s.partition(".")
    t = a.lstrip("0")
    n = int(t) if t else 0
    if n < 10:
        r = DIGR[n]
    elif n < 20:
        r = "十" + (DIGR[n % 10] if n % 10 else "")
    else:
        r = DIGR[n // 10] + "十" + (DIGR[n % 10] if n % 10 else "")
    if b:
        r += "点" + "".join(DIGR[int(c)] for c in b)
    return r


