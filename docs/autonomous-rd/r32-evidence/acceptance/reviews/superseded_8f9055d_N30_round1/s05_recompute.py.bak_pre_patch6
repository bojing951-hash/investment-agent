CNP = "[零一二三四五六七八九点]+"
DIG = {"零": 0, "一": 1, "二": 2, "三": 3, "四": 4, "五": 5, "六": 6, "七": 7, "八": 8, "九": 9}


def has(s):
    return s in T


def g(pat):
    m = re.search(pat, T)
    if not m:
        return None
    return [x if x is not None else None for x in m.groups()]


def gf(pat, idx=0):
    r = g(pat)
    if r is None:
        return None
    try:
        return float(r[idx])
    except Exception:
        return None


def cn2f(s):
    parts = s.split("点")
    ip = 0
    for ch in parts[0]:
        ip = ip * 10 + DIG[ch]
    if len(parts) == 1:
        return float(ip)
    fr = 0.0
    for i, ch in enumerate(parts[1]):
        fr += DIG[ch] * (10.0 ** -(i + 1))
    return ip + fr


def gcn(pat, idx=0):
    r = g(pat)
    if r is None or r[idx] is None:
        return None
    return cn2f(r[idx])


